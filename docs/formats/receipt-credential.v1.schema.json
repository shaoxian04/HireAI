{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hireai:format:receipt-credential.v1",
  "title": "HireAI receipt as a W3C Verifiable Credential 2.0",
  "description": "The document served by GET /api/receipts/{id}/credential: a VC 2.0 credential secured with a Data Integrity proof (cryptosuite eddsa-jcs-2022). credentialSubject.receipt with credentialSubject.receiptSignature, read as {\"receipt\":…,\"signature\":…}, is the stored receipt and validates against receipt.v1.schema.json. Prose: docs/details/receipts.md#exports.",
  "type": "object",
  "required": ["@context", "id", "type", "issuer", "validFrom", "credentialSubject", "proof"],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        { "const": "https://www.w3.org/ns/credentials/v2" },
        {
          "const": {
            "receipt": { "@id": "https://www.w3.org/ns/credentials/issuer-dependent#hireaiReceipt", "@type": "@json" },
            "receiptSignature": { "@id": "https://www.w3.org/ns/credentials/issuer-dependent#hireaiReceiptSignature", "@type": "@json" }
          }
        }
      ]
    },
    "id": { "type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "type": {
      "type": "array",
      "allOf": [
        { "contains": { "const": "VerifiableCredential" } },
        { "contains": { "const": "HireAIReceiptCredential" } }
      ]
    },
    "issuer": { "$ref": "#/$defs/didKey" },
    "validFrom": { "$ref": "#/$defs/time" },
    "credentialSubject": {
      "type": "object",
      "required": ["receipt", "receiptSignature"],
      "properties": {
        "receipt": {
          "type": "object",
          "required": ["format", "receiptId", "keyId"],
          "properties": { "format": { "const": "hireai.receipt.v1" } }
        },
        "receiptSignature": {
          "type": "object",
          "required": ["alg", "keyId", "value"],
          "properties": { "alg": { "const": "Ed25519" } }
        }
      }
    },
    "proof": {
      "type": "object",
      "required": ["type", "cryptosuite", "created", "verificationMethod", "proofPurpose", "proofValue"],
      "properties": {
        "type": { "const": "DataIntegrityProof" },
        "cryptosuite": { "const": "eddsa-jcs-2022" },
        "created": { "$ref": "#/$defs/time" },
        "verificationMethod": { "type": "string", "pattern": "^did:key:(z6Mk[1-9A-HJ-NP-Za-km-z]+)#\\1$" },
        "proofPurpose": { "const": "assertionMethod" },
        "proofValue": { "type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$" }
      }
    }
  },
  "$defs": {
    "didKey": { "type": "string", "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]+$" },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,9})?)?Z$" }
  }
}
